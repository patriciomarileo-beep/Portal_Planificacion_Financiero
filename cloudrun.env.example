# En producci?n, AUTH_SESSION_SECRET se obtiene desde Secret Manager.
# Local: genera al menos 32 bytes aleatorios, nunca uses un valor de ejemplo.
APP_ORIGIN=https://plataforma-planificacion-financiera-276495805166.us-east4.run.app
BIGQUERY_AUTH_MODE=adc
BIGQUERY_PROJECT_ID=forus-cl-planificacion
BIGQUERY_TABLE=forus-cl-planificacion.Planificacion.ft_cl_planificacion_TB_STG_CL_TALANA_PERSONA
BIGQUERY_IMPORTS_TABLE=forus-analitica-test-datalake.silver.ft_cl_planificacion_importaciones_industria
# Destino de captura Toolbox AP (Streaming Inserts)
PROJECT_ID=forus-cl-planificacion
DATASET_ID=Planificacion
TABLE_ID=toolbox_ap_ingesta
GOOGLE_OAUTH_CLIENT_ID=
DISABLE_GOOGLE_LOGIN=false

CLOUD_RUN_PROJECT=forus-cl-planificacion
CLOUD_RUN_REGION=us-east4
CLOUD_RUN_SERVICE=plataforma-planificacion-financiera
CLOUD_RUN_SERVICE_ACCOUNT=portal-planificacion@forus-cl-planificacion.iam.gserviceaccount.com
CLOUD_RUN_AUTH_SECRET=AUTH_SESSION_SECRET:latest
# Imagen construida y escaneada con cloudbuild.security.yaml (sin tag mutable).
CLOUD_RUN_IMAGE=
# Opcional: ruta al ejecutable oficial de Trivy; por defecto se busca en PATH.
TRIVY_BINARY=
CLOUD_RUN_ALLOW_UNAUTHENTICATED=false
# Solo para una excepci?n aprobada de infraestructura con IAP/control equivalente:
CLOUD_RUN_PUBLIC_ACCESS_REASON=
