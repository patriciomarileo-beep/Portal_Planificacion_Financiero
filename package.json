{
  "name": "rentabilidad-tiendas-2027",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/apply-security-patches.mjs",
    "test:security:patches": "node scripts/apply-security-patches.mjs --check && node --test tests/security-patches.test.mjs",
    "test:security:deployment": "node --test tests/deployment-security.test.mjs",
    "dev": "node --env-file=.env.local scripts/dev.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "build:cloudrun": "next build",
    "start:cloudrun": "next start -H 0.0.0.0",
    "start:local": "node --env-file=.env.local scripts/start-local.mjs",
    "deploy:cloudrun": "node scripts/deploy-cloudrun.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "bigquery:smoke": "node scripts/bigquery-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "test:security": "node scripts/test-security.mjs",
    "test:sales-margin": "node --test tests/bigquery-pagination.test.mjs tests/sales-margin-loading.test.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "test:security:http": "node scripts/smoke-security.mjs",
    "test:security:assets": "node scripts/check-public-data.mjs",
    "test:market": "node scripts/test-market-indicators.mjs",
    "test:imports": "node scripts/test-imports.mjs"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.1.0",
    "@hookform/resolvers": "^5.9.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "11.3.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.89.0",
    "recharts": "^2.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "satori": {
      "fflate": "0.7.5"
    },
    "miniflare": {
      "undici": "7.30.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
